rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    function isClubAdmin(clubId) {
      return isSignedIn()
        && request.auth.token.role == 'clubadmin'
        && request.auth.token.clubId == clubId;
    }

    // Any signed-in user whose token clubId matches this club
    // (covers clubadmin AND regular members, since both get a clubId claim)
    function belongsToClub(clubId) {
      return isSignedIn() && request.auth.token.clubId == clubId;
    }

    function isClubMember(clubId) {
      return isSuperadmin() || belongsToClub(clubId);
    }

    // ============================================
    // USERS COLLECTION (top-level, doc ID = auth uid)
    // ============================================

    match /users/{userId} {
      // Any signed-in user can read user profiles (adjust if you want this tighter,
      // e.g. limit to same-club users only)
      allow read: if isSignedIn();

      // Users can update their OWN profile fields, but may NOT change their
      // own role or clubId — those are security-sensitive and only settable
      // via the Admin SDK script (custom claims), not through this document.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.clubId == resource.data.clubId;

      // Only superadmin can freely create/overwrite user docs (e.g. role field
      // kept here for display purposes only — the real authority is the token claim)
      allow create, delete: if isSuperadmin();
      allow write: if isSuperadmin();
    }

    // ============================================
    // CLUBS COLLECTION (top-level) + subcollections
    // ============================================

    match /clubs/{clubId} {
      // Superadmin manages all clubs; clubadmin manages their own club doc
      allow read: if isClubMember(clubId);
      allow write: if isSuperadmin() || isClubAdmin(clubId);

      match /players/{playerId} {
        allow read, write: if isClubMember(clubId);
      }

      match /teams/{teamId} {
        allow read, write: if isClubMember(clubId);
      }
    }

    // ============================================
    // DEFAULT DENY
    // Anything not explicitly matched above is blocked.
    // (Firestore denies by default anyway, this is just explicit for clarity.)
    // ============================================
  }
}
